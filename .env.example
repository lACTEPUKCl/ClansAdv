# ── Discord ──
DISCORD_TOKEN=          # токен бота
GUILD_ID=              # ID сервера
CHANNEL_ID=            # ID рекламного канала
DISCORD_PROXY_URL=     # (необязательно) http-прокси для Discord

# ── MongoDB (общая БД с rns-site) ──
# Та же строка подключения, что и у сайта (MONGO_URI бэкенда rns-site).
# Бот читает одобренные посты кланов из коллекции clan_ad_posts.
MONGO_URI=
MONGO_DB=ticketBotDB   # имя БД (по умолчанию ticketBotDB)

# ── Поведение ──
# LEGACY_POSTS=false отключает старые захардкоженные посты (message1..8),
# оставляя только динамические посты кланов из БД. По умолчанию включены.
LEGACY_POSTS=true
